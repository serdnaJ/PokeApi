@{
    ViewData["Title"] = "Error de conexión";
}

<div class="alert alert-danger mt-4">
    <h4 class="alert-heading">No se pudo consultar la PokéAPI</h4>
    <p>Revisa tu conexión a internet o inténtalo de nuevo más tarde.</p>
    <hr />
    <p class="mb-0 small">Detalle técnico: @ViewBag.Message</p>
</div>
<a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Volver al inicio</a>
